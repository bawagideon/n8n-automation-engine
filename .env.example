# AutoOps Environment Configuration
# Add these environment variables in your Vercel Project Settings

# The private base URL of your Railway n8n instance (NEVER exposed to browser)
# Example: https://primary-production-xxxx.up.railway.app
N8N_BASE_URL=

# Shared secret header forwarded by /api/hook/[key] to n8n
N8N_HOOK_SECRET=your_super_secret_webhook_token_here

# Optional: Upstash Redis for distributed multi-region rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
